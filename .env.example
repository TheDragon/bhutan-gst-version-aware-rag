# Copy this file to .env (same folder) and fill in your key.
# .env is ignored by Git, so the key is never committed.

# Google Gemini API key (from Google AI Studio). Leave empty to run offline.
GEMINI_API_KEY=

# Optional: Gemini model id used for query rewriting and answers.
GEMINI_MODEL=gemini-3.7-flash

# Optional: set to 0 to turn Gemini off without removing the key.
# GST_USE_GEMINI=0
